{
  "firestore": { "rules": "firestore.rules" },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs20", "predeploy": ["npm --prefix \"$RESOURCE_DIR\" install", "npm --prefix \"$RESOURCE_DIR\" run build"] }
  ],
  "hosting": {
    "public": "web",
    "ignore": ["src/**", "**/*.ts", "firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": { "auth": { "port": 9099 }, "functions": { "port": 5001 }, "firestore": { "port": 8080 }, "ui": { "enabled": true } }
}
